APP_NAME="Inmo Pro CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Herd: https://{nombre-carpeta-en-kebab-case}.test (ej. crm-lotes.test). Debe incluir https://
APP_URL=https://crm-lotes.test
APP_TIMEZONE=America/Lima

# Front React (catálogo público) — origen del API GET /api/v1/web
# VITE_INMOPRO_API_URL=http://localhost

APP_LOCALE=es_PE
APP_FALLBACK_LOCALE=es_PE
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# local: public (php artisan storage:link). Producción: gcs + GOOGLE_CLOUD_*
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Google Cloud Storage (producción: FILESYSTEM_DISK=gcs)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=
# Opcional fuera de GCP. En GCP se recomienda Application Default Credentials.
GOOGLE_CLOUD_KEY_FILE_PATH=
# Credenciales de cuenta de servicio (sin archivo JSON en el repo)
GOOGLE_CLOUD_ACCOUNT_TYPE=service_account
GOOGLE_CLOUD_PRIVATE_KEY_ID=
GOOGLE_CLOUD_PRIVATE_KEY=
GOOGLE_CLOUD_CLIENT_EMAIL=
GOOGLE_CLOUD_CLIENT_ID=
GOOGLE_CLOUD_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_CLOUD_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_CLOUD_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLOUD_CLIENT_CERT_URL=
# El bucket permanece privado; estas vigencias controlan las URLs firmadas.
GCS_CATALOG_URL_TTL_MINUTES=60
GCS_SENSITIVE_URL_TTL_MINUTES=10

# Maps JavaScript API (restringir por HTTP referrer en Google Cloud)
GOOGLE_MAPS_API_KEY=

# OAuth de usuario (CRM login, Cazador, Datero) + Google Calendar API
# Crear en Google Cloud Console → APIs & Services → Credentials (mismo proyecto).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/crm/auth/google/callback"
GOOGLE_CALENDAR_REDIRECT_URI="${APP_URL}/crm/google/calendar/callback"
GOOGLE_CALENDAR_ENABLED=true
# Client IDs nativos para verificar id_token de apps móviles (OAuth 2.0 Client IDs)
# Cazador Android: package com.abitae.app_cazador + SHA-1 del keystore (EAS/Play)
# Cazador iOS: bundle com.abitae.cazador1
GOOGLE_CAZADOR_IOS_CLIENT_ID=
GOOGLE_CAZADOR_ANDROID_CLIENT_ID=
# Datero Android: com.inmopro.datero | iOS: com.abitae.datero1
GOOGLE_DATERO_IOS_CLIENT_ID=
GOOGLE_DATERO_ANDROID_CLIENT_ID=
# Validar: php artisan google:oauth-check --app=cazador

# Meta Business — mensajería unificada (WhatsApp, Messenger, Instagram)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_REDIRECT_URI=
META_TOKEN_ENCRYPTION_KEY=
# REVERB_APP_ID=
# BROADCAST_CONNECTION=reverb

VITE_APP_NAME="${APP_NAME}"

# Laravel AI SDK — el proyecto usa el proveedor openai (config/ai.php)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# API Cazador — enlaces temporales para compartir assets (config/cazador.php)
CAZADOR_ASSET_SHARE_TTL_HOURS=48
CAZADOR_ASSET_SHARE_MAX_ASSETS=20
# Opcional: dominio público si difiere de APP_URL (p. ej. https://inmopro.laravel.cloud)
# CAZADOR_ASSET_SHARE_URL_ROOT=
# Disco de archivos (hereda FILESYSTEM_DISK; en producción: gcs)
# CAZADOR_PROJECT_ASSET_DISK=gcs

# App Cazador — versión vigente vs instalada (versionCode / buildNumber)
CAZADOR_ANDROID_LATEST_VERSION_CODE=7
CAZADOR_ANDROID_MIN_VERSION_CODE=1
CAZADOR_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.abitae.app_cazador
CAZADOR_IOS_LATEST_BUILD_NUMBER=7
CAZADOR_IOS_MIN_BUILD_NUMBER=1
# CAZADOR_IOS_STORE_URL=

# Módulo OpenAI Cazador (config/openai_cazador.php) — catálogo y chat para app Cazador
OPENAI_CAZADOR_ENABLED=false
OPENAI_CAZADOR_MODEL=
OPENAI_CAZADOR_MAX_MESSAGE_LENGTH=2000
OPENAI_CAZADOR_RATE_LIMIT=8
OPENAI_CAZADOR_KNOWLEDGE_RATE_LIMIT=60

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Herd: https://{nombre-carpeta-en-kebab-case}.test (ej. crm-lotes.test). Debe incluir https://
APP_URL=https://crm-lotes.test
APP_TIMEZONE=America/Lima

# Front React (catálogo público) — origen del API GET /api/v1/web
# VITE_INMOPRO_API_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Laravel AI SDK (config/ai.php) — rellena las claves del proveedor definido en default (p. ej. OPENAI si default=openai)
# https://laravel.com/docs/13.x/ai-sdk
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_URL=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
COHERE_API_KEY=
DEEPSEEK_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
JINA_API_KEY=
MISTRAL_API_KEY=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=

# API Cazador — enlaces temporales para compartir assets (config/cazador.php)
CAZADOR_ASSET_SHARE_TTL_HOURS=48
CAZADOR_ASSET_SHARE_MAX_ASSETS=20
# Opcional: dominio público si difiere de APP_URL (p. ej. https://inmopro.laravel.cloud)
# CAZADOR_ASSET_SHARE_URL_ROOT=

# Módulo OpenAI Cazador (config/openai_cazador.php) — catálogo y chat para app Cazador
OPENAI_CAZADOR_ENABLED=true
OPENAI_CAZADOR_MODEL=
OPENAI_CAZADOR_MAX_MESSAGE_LENGTH=2000
OPENAI_CAZADOR_RATE_LIMIT=8
OPENAI_CAZADOR_KNOWLEDGE_RATE_LIMIT=60
OPENROUTER_API_KEY=
VOYAGEAI_API_KEY=
XAI_API_KEY=
